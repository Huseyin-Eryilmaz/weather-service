# Copy to .env and adjust. The real .env is gitignored: it is where
# secrets live, and secrets do not belong in version control.
#
# These defaults match docker-compose.yml, so `docker compose up` works
# without a .env at all. You need one only when running the API directly
# on your machine, where "db" and "cache" are not resolvable hostnames.

ENVIRONMENT=development
DEBUG=true

# Note the hostnames: inside compose they are service names; on the host
# they would be localhost.
DATABASE_URL=postgresql+asyncpg://weather:weather@localhost:5432/weather
REDIS_URL=redis://localhost:6379/0

DB_ECHO=false
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
